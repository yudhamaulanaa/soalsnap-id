# Basis data SQLite (berkas lokal). Ganti ke Postgres saat produksi.
DATABASE_URL="file:./dev.db"

# Asal aplikasi untuk menyusun tautan absolut di surel. Wajib diisi saat
# produksi: tanpa ini tautan mengikuti header Host yang bisa dipalsukan.
APP_URL="http://localhost:3000"

# Pengiriman tautan lewat Resend. Kalau salah satu kosong, aplikasi tetap
# jalan — tautannya hanya dicatat ke log server, tidak dikirim.
RESEND_API_KEY=""
EMAIL_FROM="SoalSnap <tautan@soalsnap.id>"
