# Basis data SQLite (berkas lokal). Ganti ke Postgres saat produksi.
DATABASE_URL="file:./dev.db"

# Asal aplikasi untuk menyusun tautan absolut di surel. Wajib diisi saat
# produksi: tanpa ini tautan mengikuti header Host yang bisa dipalsukan.
APP_URL="http://localhost:3000"

# Pengiriman tautan lewat Mailgun. Kalau salah satu dari tiga yang pertama
# kosong, aplikasi tetap jalan — tautannya hanya dicatat ke log server.
MAILGUN_API_KEY=""
MAILGUN_DOMAIN="mail.soalsnap.web.id"
EMAIL_FROM="SoalSnap <tautan@mail.soalsnap.web.id>"
EMAIL_REPLY_TO="noreply@soalsnap.web.id"
# Isi https://api.eu.mailgun.net kalau akun Mailgun-nya di region Eropa.
MAILGUN_BASE_URL=""

# Halaman admin (/admin) untuk audit soal & moderasi. Selama ADMIN_PASSWORD
# kosong, halaman admin tertutup dan tidak ada sandi bawaan.
ADMIN_PASSWORD=""
# Opsional: kunci tanda tangan cookie sesi admin. Bila kosong, sandi di atas
# yang dipakai — sehingga mengganti sandi otomatis membatalkan sesi berjalan.
ADMIN_SECRET=""
