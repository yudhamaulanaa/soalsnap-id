# Salin berkas ini menjadi .env, lalu isi yang diperlukan.
#
# Pola yang berlaku di seluruh aplikasi: variabel yang dikosongkan mematikan
# fiturnya, bukan menjatuhkan aplikasinya. Tidak ada nilai bawaan yang diam-diam
# aktif — terutama untuk sandi dan kunci.

# ─── Wajib ───────────────────────────────────────────────────────────────────

# Basis data SQLite (berkas lokal). Ganti ke Postgres saat produksi.
DATABASE_URL="file:./dev.db"

# Asal aplikasi untuk menyusun tautan absolut di surel. Wajib diisi saat
# produksi: tanpa ini tautan mengikuti header Host yang bisa dipalsukan.
APP_URL="http://localhost:3000"


# ─── Pengiriman surel (Mailgun) ──────────────────────────────────────────────
#
# Menyalakan: tautan aktivitas di halaman Bagikan, dan tautan masuk ke akun.
# Kalau MAILGUN_API_KEY, MAILGUN_DOMAIN, atau EMAIL_FROM kosong, aplikasi tetap
# jalan — surelnya hanya dicatat ke log server, tidak dikirim.
#
# Domainnya harus diverifikasi lebih dulu di Mailgun (SPF, DKIM, MX, CNAME).

MAILGUN_API_KEY=""
MAILGUN_DOMAIN="mail.soalsnap.web.id"
EMAIL_FROM="SoalSnap <tautan@mail.soalsnap.web.id>"
# Opsional: alamat balasan. Kosong berarti balasan kembali ke EMAIL_FROM.
EMAIL_REPLY_TO="noreply@soalsnap.web.id"
# Opsional: isi https://api.eu.mailgun.net kalau akun Mailgun-nya region Eropa.
MAILGUN_BASE_URL=""


# ─── Penyimpanan berkas (Cloudflare R2) ──────────────────────────────────────
#
# Menyalakan: unggah dokumen soal dan gambar soal. Selama belum lengkap,
# unggahan ditolak dengan 503 — tidak ada penyimpanan cadangan.
#
# Bucket-nya perlu CORS yang mengizinkan PUT dari APP_URL, karena peramban
# mengunggah langsung ke R2 tanpa melewati server aplikasi.

R2_BUCKET="soalsnap-unggahan"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Isi salah satu: R2_ACCOUNT_ID membentuk endpoint bawaan
# https://<akun>.r2.cloudflarestorage.com, sedangkan R2_ENDPOINT menimpanya
# untuk jurisdiksi khusus atau server tiruan saat uji.
R2_ACCOUNT_ID=""
R2_ENDPOINT=""


# ─── Akun pengguna ───────────────────────────────────────────────────────────
#
# Menyalakan: masuk lewat tautan email (/masuk) dan halaman Soal Saya.
# Selama kosong, fitur masuk tertutup dan aplikasi tetap jalan penuh tanpa akun.
# Menggantinya membatalkan semua sesi yang sedang berjalan.
#
# Buat nilainya acak, jangan diketik sendiri:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

AUTH_SECRET=""


# ─── Worker pembaca dokumen ──────────────────────────────────────────────────
#
# Menyalakan: /api/worker/* yang dipakai worker OCR mengambil job dari antrean.
# Selama kosong, endpoint worker menolak dengan 503 dan dokumen menumpuk di
# antrean tanpa pernah dibaca.
#
# Worker berjalan di mesin terpisah dan hanya memegang token ini — bukan
# kredensial basis data, bukan kunci R2. Berkas diunduhnya lewat tautan
# bertanda tangan berumur pendek yang diberikan server.
#
# Pakai perintah pembuat nilai acak yang sama seperti di atas.

WORKER_TOKEN=""


# ─── Halaman admin ───────────────────────────────────────────────────────────
#
# Menyalakan: /admin untuk audit soal dan moderasi. Selama ADMIN_PASSWORD
# kosong, halaman admin tertutup dan tidak ada sandi bawaan.
#
# Pakai perintah yang sama seperti di atas untuk membuat sandinya.

ADMIN_PASSWORD=""
# Opsional: kunci tanda tangan cookie sesi admin. Bila kosong, sandi di atas
# yang dipakai — sehingga mengganti sandi otomatis membatalkan sesi berjalan.
ADMIN_SECRET=""
