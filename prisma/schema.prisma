// Model data SoalSnap — mengikuti frd.md §8, ditambah kebutuhan baru:
// tanpa akun, dua tautan rahasia per aktivitas, dan katalog soal publik.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Activity {
  id String @id @default(cuid())

  /// Pemilik akun bila pembuatnya sedang masuk; null berarti dibuat sebagai tamu.
  /// Aktivitas tamu tetap sah — akun hanya mengumpulkannya, bukan mensyaratkannya.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Tautan rahasia pemilik soal — untuk mengedit & melihat rekap.
  editSlug String @unique
  /// Tautan publik yang dibagikan ke peserta.
  playSlug String @unique

  title    String
  template String

  // Pengaturan main
  acak       Boolean @default(false)
  timerOn    Boolean @default(true)
  timerDetik Int     @default(20)

  /// "private" (hanya lewat tautan) atau "public" (tampil di katalog).
  visibility String @default("private")
  /// Kategori katalog; null berarti belum dipilih.
  kelas String?
  mapel String?

  // Kontak pembuat — opsional, hanya untuk mengirimkan kembali tautannya.
  creatorName  String?
  creatorEmail String?
  creatorPhone String?

  /// Alamat tujuan terakhir yang berhasil dikirimi tautan. Menjadi penjaga
  /// agar tautan tidak dikirim ulang setiap kali kontak disimpan.
  linkSentTo String?
  linkSentAt DateTime?

  /// Jejak moderasi: diisi saat admin menurunkan aktivitas dari katalog.
  takedownAt     DateTime?
  takedownAlasan String?

  plays     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
  sessions  PlaySession[]
  reports   Report[]

  @@index([visibility, kelas, mapel])
  @@index([visibility, createdAt])
  @@index([userId, createdAt])
}

model Question {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  /// Urutan tampil di editor & permainan.
  urutan Int

  /// "pg" | "bs" | "isian"
  type String
  q    String
  /// Daftar opsi sebagai JSON; SQLite tidak punya tipe larik.
  opts String?
  /// Indeks kunci jawaban untuk pg/bs.
  correct Int?
  /// Kunci jawaban teks untuk isian.
  kunci String?

  /// Kunci objek gambar soal di R2 (selalu berprefiks "soal/"); null berarti
  /// soal ini murni teks.
  gambar    String?
  /// Teks alternatif gambar, untuk pembaca layar dan saat gambar gagal dimuat.
  gambarAlt String?

  conf   Int     @default(100)
  low    Boolean @default(false)
  note   String?
  clue   String?
  page   Int?
  sumber String  @default("manual")

  @@index([activityId, urutan])
}

model PlaySession {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  /// Nama peserta; kosong berarti bermain anonim.
  playerName String?
  score      Int
  total      Int
  /// Mode main yang dipakai, untuk membedakan rekap antar template.
  mode       String   @default("kuis")
  createdAt  DateTime @default(now())

  @@index([activityId, score])
  @@index([activityId, createdAt])
}

/// Laporan konten dari peserta atau guru lain — antrean tinjauan admin.
model Report {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  /// Salah satu alasan baku di src/lib/laporan.ts.
  alasan String
  /// Keterangan bebas dari pelapor.
  catatan String?
  /// Sidik pelapor (hash), hanya untuk membatasi laporan berulang — bukan identitas.
  pelapor String?

  /// "baru" | "ditangani" | "diabaikan"
  status    String    @default("baru")
  createdAt DateTime  @default(now())
  /// Kapan admin menutup laporan ini.
  selesaiAt DateTime?

  @@index([status, createdAt])
  @@index([activityId])
}

/// Satu permintaan konversi dokumen menjadi soal.
///
/// Dokumen yang diunggah tidak diproses seketika: job masuk antrean, lalu
/// diambil worker yang berjalan terpisah. Kolom klaim menjaga satu job tidak
/// dikerjakan dua worker sekaligus.
model ParseJob {
  id String @id @default(cuid())

  /// Tautan rahasia pemantau. Tanpa akun, token inilah izin melihat hasilnya.
  token String @unique

  /// "menyusun" | "antre" | "diproses" | "selesai" | "gagal"
  status  String  @default("menyusun")
  progres Int     @default(0)
  /// Label tahap yang sedang berjalan, untuk layar Proses AI.
  tahap   String?
  galat   String?

  /// Soal hasil worker sebagai JSON; kosong sampai job selesai.
  hasil String?

  /// Kode galat stabil (SOURCE_NOT_FOUND, PDF_ENCRYPTED, …) untuk ditindaklanjuti
  /// program; `galat` di atas adalah kalimat untuk manusia.
  kodeGalat String?

  // Provenance: tanpa ini hasil ekstraksi tidak bisa direproduksi saat model
  // atau prompt-nya berganti.
  provider         String?
  model            String?
  promptVersion    String?
  schemaVersion    String?
  extractorVersion String?

  halamanTotal   Int @default(0)
  halamanSelesai Int @default(0)
  soalTerdeteksi Int @default(0)
  perluTinjau    Int @default(0)

  workerId  String?
  klaimAt   DateTime?
  percobaan Int       @default(0)

  createdAt DateTime  @default(now())
  antreAt   DateTime?
  selesaiAt DateTime?

  uploads Upload[]

  @@index([status, antreAt])
}

/// Satu berkas milik sebuah job, tersimpan di bucket R2.
model Upload {
  id    String   @id @default(cuid())
  jobId String
  job   ParseJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// Kunci objek di R2.
  key         String @unique
  namaAsli    String
  /// "image" | "pdf" | "docx" | "text"
  kind        String
  contentType String

  /// Ukuran byte, diisi ulang dari R2 saat unggahan dikonfirmasi.
  ukuran Int @default(0)
  /// Jumlah halaman sebenarnya, dihitung di server (FR-UP-5).
  halaman Int @default(1)

  /// Objeknya sudah benar-benar ada di R2, bukan sekadar dijanjikan klien.
  tersimpan Boolean @default(false)
  urutan    Int
  createdAt DateTime @default(now())

  halamanDokumen HalamanDokumen[]

  @@index([jobId, urutan])
}

/// Satu halaman dokumen: hasil render, hasil ekstraksi model, dan hasil OCR.
///
/// Semuanya disimpan mentah sebelum ditafsirkan menjadi soal — kalau
/// penyusunannya salah, bahan aslinya masih ada untuk diperiksa tanpa perlu
/// mengulang pemrosesan. Barisnya juga menjadi checkpoint per halaman: saat job
/// diulang, halaman yang sudah selesai tidak dikerjakan lagi (FR-019).
model HalamanDokumen {
  id       String @id @default(cuid())
  uploadId String
  upload   Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  /// Nomor halaman di dalam berkas itu, mulai dari 1.
  halaman Int

  /// "tertunda" | "selesai" | "gagal" — checkpoint per halaman.
  status String @default("tertunda")

  /// Kunci objek render halaman di R2, beserta ukuran pikselnya. Ukuran ini
  /// yang dipakai mengubah bbox ternormalisasi menjadi piksel saat memotong.
  kunciRender String?
  lebar       Int?
  tinggi      Int?

  /// Hasil ekstraksi model apa adanya (JSON PageExtraction), untuk audit dan
  /// untuk mengulang penggabungan tanpa memanggil model lagi.
  rawEkstraksi String?

  // — Hasil OCR; kini jalur cadangan, jadi boleh kosong —
  /// Teks polos urut baca.
  teks  String?
  /// Baris OCR sebagai JSON: [{ teks, konfidensi, kotak: [x1,y1,x2,y2] }].
  baris String?
  /// Konfidensi 0–100; yang terendah menandai halaman perlu diperiksa.
  konfidensiMin  Int?
  konfidensiRata Int?

  /// Lama pemrosesan halaman ini, untuk melihat beban worker.
  msProses Int?

  createdAt DateTime @default(now())

  @@unique([uploadId, halaman])
  @@index([uploadId, halaman])
}

/// Akun opsional.
///
/// Aplikasi tetap bisa dipakai tanpa masuk; akun hanya mengumpulkan aktivitas
/// supaya bertahan lintas perangkat dan tidak ikut hilang bersama penyimpanan
/// peramban.
model User {
  id    String  @id @default(cuid())
  email String  @unique
  nama  String?

  createdAt       DateTime  @default(now())
  terakhirMasukAt DateTime?

  activities  Activity[]
  loginTokens LoginToken[]
}

/// Tautan masuk sekali pakai yang dikirim ke surel.
model LoginToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Hash tokennya, bukan tokennya sendiri: basis data yang bocor tidak boleh
  /// berubah menjadi izin masuk ke akun siapa pun.
  hash String @unique

  kedaluwarsaAt DateTime
  /// Diisi saat ditukar dengan sesi; token yang sudah terpakai tidak berlaku lagi.
  dipakaiAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}
